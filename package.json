{
  "name": "changui",
  "version": "0.1.0",
  "description": "CLI tool to map and visualize Git status changes grouped by project architecture",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "changui": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "cli",
    "monorepo",
    "architecture",
    "tui",
    "ink"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "tsup": "^8.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
